# ============================================================
# Salin ke .env lalu isi nilainya:
#   cp .env.example .env
#
# Dipakai oleh docker-compose.yml untuk WA Gateway (sikebut-wa).
# Nilai WA_GATEWAY_KEY harus SAMA dengan yang ada di .env backend Laravel.
# ============================================================

# Kunci rahasia untuk header X-Gateway-Key (WAJIB diganti di produksi!)
WA_GATEWAY_KEY=knsaIgguyGYUCA86756554aanauysd2y3urg26gyacba

# Port gateway (container selalu 3001; HOST default 0.0.0.0 di compose)
WA_PORT=3001

# Alamat backend Laravel DARI DALAM container WA.
# Satu network (app-network) -> pakai nama container nginx backend:
LARAVEL_URL=http://sikebut-api-nginx:80

# Interval heartbeat ke Laravel (ms)
WA_HEARTBEAT_MS=30000
